# Supabase: pooled connection (Supavisor, "Transaction" mode, port 6543) — used by the app at runtime.
# Dashboard > Project Settings > Database > Connection string > "Transaction pooler" tab.
# connection_limit=1 avoids exhausting the pool during `next dev` hot-reload; raise it in production if needed.
# DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-x.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase: true direct connection (bypasses the pooler entirely, port 5432) — used only for
# `prisma migrate` / `prisma db push`, which need to run DDL and hold a session-level lock.
# Dashboard > Project Settings > Database > Connection string > "Direct connection" tab.
# Note: this host is db.<project-ref>.supabase.co, NOT the pooler host above.
# If your network is IPv4-only, direct connections may fail (Supabase's direct host is IPv6-only
# on the free tier) — use the "Session pooler" connection string (same pooler host, port 5432) instead.
# DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres"

# ------------------------------------------------------------------
# Alternative DB option: a cPanel-hosted PostgreSQL database, connected
# to DIRECTLY (no PHP in between) — use this if your cPanel plan allows
# external/remote connections to its Postgres (check cPanel's "Remote
# MySQL®/PostgreSQL" access-control page, and whitelist your app's
# server IP there). Just set DATABASE_URL (and DIRECT_URL the same) to
# your cPanel Postgres connection string instead of Supabase's, e.g.:
#   DATABASE_URL="postgresql://cpaneluser_dbuser:password@yourdomain.com:5432/cpaneluser_posdb"
# Nothing else needs to change — Prisma just talks to a different host.
# ------------------------------------------------------------------

AUTH_SECRET="7f4c9e2a1b8d63f05a7c91e4d2b6f830c5a19e7b3d8f42a6c1e9b0574d6f83a2"

# ------------------------------------------------------------------
# Alternative DB option: cPanel via the PHP gateway — use this when
# your cPanel host does NOT allow external connections to its
# database at all, only PHP running on that same server can reach it.
# See /gateway/README.md for full setup. When gateway mode is on, the
# app calls PHP scripts on your cPanel host instead of using
# DATABASE_URL/Prisma for its data operations from the browser.
# ------------------------------------------------------------------
NEXT_PUBLIC_BACKEND_MODE="gateway"
NEXT_PUBLIC_GATEWAY_URL="https://wonderbizz.top/gateway"

# Optional: weighing-scale integration (see /scale-bridge). Only
# needed if the scale-bridge service isn't running on localhost:4501
# (its default) — e.g. it's on another till on the local network.
# NEXT_PUBLIC_SCALE_BRIDGE_URL="ws://localhost:4501"

# ------------------------------------------------------------------
# M-Pesa: if NEXT_PUBLIC_BACKEND_MODE=gateway (see above), STK push and
# the webhook run entirely in PHP instead — set these same values as
# real env vars (or in gateway/config.local.php) on your cPanel host,
# see gateway/README.md. The vars below are only read by the Next.js
# app itself, i.e. when NOT using gateway mode for payments.
# ------------------------------------------------------------------
MPESA_ENV="production"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_PASSKEY=""
MPESA_SHORTCODE=""
# "paybill" (default) or "till" — controls the Daraja TransactionType only.
MPESA_SHORTCODE_TYPE="paybill"
MPESA_CALLBACK_URL="https://your-domain.example.com/api/webhooks/mpesa"

PESAPAL_ENV="sandbox"
PESAPAL_CONSUMER_KEY=""
PESAPAL_CONSUMER_SECRET=""
PESAPAL_IPN_ID=""
PESAPAL_IPN_URL="https://your-domain.example.com/api/webhooks/pesapal"

CARD_PROVIDER="stub"
CARD_API_KEY=""
CARD_WEBHOOK_SECRET=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"
