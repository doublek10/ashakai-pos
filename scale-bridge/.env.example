# Copy this file to .env and adjust for your scale.

# The serial port the scale is plugged into.
#   Windows:      COM3, COM4, ...            (Device Manager > Ports)
#   macOS:        /dev/tty.usbserial-XXXX     (run "npm run list-ports")
#   Linux:        /dev/ttyUSB0, /dev/ttyS0    (run "npm run list-ports")
SCALE_PORT=COM3

# Common values: 1200, 2400, 4800, 9600 (most common), 19200.
# Check your scale indicator's manual/DIP switches — it must match.
SCALE_BAUD_RATE=9600

SCALE_DATA_BITS=8
SCALE_STOP_BITS=1
# none | even | odd
SCALE_PARITY=none

# Which continuous-output protocol the indicator sends. Most cheap
# Chinese indicators and A&D/CAS-compatible ones use "generic", which
# just pulls the first signed decimal number out of each line, e.g.
#   "ST,+001.235kg\r\n" -> 1.235
#   "US,+  12.50 kg\r\n" -> 12.50
# If your scale needs something stricter, set SCALE_PROTOCOL=custom
# and edit the parseLine() function in server.js.
SCALE_PROTOCOL=generic

# Unit the scale is sending readings in. This is just a label passed
# through to the POS — it does not convert units.
SCALE_UNIT=kg

# Port this bridge listens on for the POS's browser tab to connect to.
BRIDGE_PORT=4501

# Restrict which origins may connect (comma-separated). Leave as * for
# a single-till setup on localhost; tighten this if the POS is served
# from a real domain and reaches this bridge over the LAN.
BRIDGE_ALLOWED_ORIGINS=*
